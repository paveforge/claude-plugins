#!/usr/bin/env python3
"""Print one value from a YAML file.

    yaml-reader <file> <dotted.key>

A scalar prints as-is, a mapping as key=value lines, a list one item per line.
Exit 3 when the key is absent, 1 when the file cannot be read or parsed.

Parsing is pave_yaml's: PyYAML when installed, otherwise a built-in parser
that reads the subset Pave uses and rejects anything else rather than guessing.
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from pave_yaml import YamlError, load  # noqa: E402


def fmt(v):
    if isinstance(v, bool):
        return "true" if v else "false"
    return "" if v is None else str(v)


def emit(v):
    if isinstance(v, dict):
        for k, x in v.items():
            if isinstance(x, (dict, list)):
                sys.exit(f"yaml-reader: {k} is nested; ask for it by its full key")
            print(f"{k}={fmt(x)}")
    elif isinstance(v, list):
        for x in v:
            print(fmt(x))
    else:
        print(fmt(v))


def main():
    if len(sys.argv) != 3:
        sys.exit("usage: yaml-reader <file> <dotted.key>")
    path, key = sys.argv[1], sys.argv[2]
    try:
        with open(path, encoding="utf-8") as f:
            data = load(f.read())
    except OSError as e:
        sys.exit(f"yaml-reader: {e}")
    except YamlError as e:
        sys.exit(f"yaml-reader: {path}: {e}")

    v = data
    for part in key.split("."):
        if not isinstance(v, dict) or part not in v:
            sys.exit(3)
        v = v[part]
    emit(v)


if __name__ == "__main__":
    main()
